{
  "version": 2,
  "installCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "staticfiles/**",
          "static/**",
          "templates/**",
          "landing/**",
          "config/**",
          "manage.py",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
